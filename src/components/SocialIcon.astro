---
import type { SocialIcon } from '../config';

interface Props {
  icon: SocialIcon;
  class?: string;
}

const { icon, class: className = 'h-[18px] w-[18px]' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {icon === 'github' && (
    <path d="M15 22v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19 5.77 5.07 5.07 0 0 0 18.91 2S17.73 1.65 15 3.48a13.38 13.38 0 0 0-7 0C5.27 1.65 4.09 2 4.09 2A5.07 5.07 0 0 0 4 5.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 19.13V22M8 19c-3 .91-3-1.5-4.5-2" />
  )}
  {icon === 'instagram' && (
    <>
      <rect width="18" height="18" x="3" y="3" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <path d="M17.5 6.5h.01" stroke-width="2.5" />
    </>
  )}
  {icon === 'mail' && (
    <>
      <rect width="18" height="14" x="3" y="5" rx="2.5" />
      <path d="m3.5 7 7.24 5.3a2.2 2.2 0 0 0 2.52 0L20.5 7" />
    </>
  )}
</svg>
