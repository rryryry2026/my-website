---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TulipMark from '../components/TulipMark.astro';
import { site } from '../config';
import { getPublishedPosts, getYear } from '../lib/posts';
import photos from '../data/photos.json';

const posts = getPublishedPosts(await getCollection('blog'));
const latestPosts = posts.slice(0, 3);
const year = getYear();

const gallery = photos.slice(0, 3);
const { home } = site;
---

<BaseLayout intro>
  <section class="home-hero">
    <div class="container-page hero-grid">
      <div class="hero-content">
        <p class="eyebrow hero-eyebrow">{home.eyebrow}</p>

        <div class="hero-title-wrap">
          <p class="hero-pretitle">{home.pretitle}</p>
          <h1 class="hero-title">
            {home.title}<span class="hero-title-accent">{home.titleAccent}</span>
          </h1>
          <p class="hero-title-en">{home.titleEn}</p>
        </div>

        <p class="hero-lead">
          {home.lead.map((line, index) => (
            <>
              {line}
              {index < home.lead.length - 1 && <br />}
            </>
          ))}
        </p>

        <div class="hero-intro glass">
          <span class="hero-seal" aria-hidden="true">
            <TulipMark class="h-7 w-7" />
          </span>
          <div>
            <p class="hero-intro-kicker">{home.introKicker}{site.author}</p>
            <p class="hero-intro-text">{site.intro}</p>
            <p class="hero-intro-meta">
              <span>{site.location}</span>
              <span class="meta-dot"></span>
              <span>{site.role}</span>
            </p>
          </div>
        </div>

        <div class="hero-actions">
          <a class="primary-btn" href="/blog/">
            去读几封信
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a class="text-link" href="/about/">关于这个角落 <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <aside class="hero-aside" aria-label="黄昏手记">
        <div class="hero-postcard">
          <p class="postcard-stamp">{home.postcard.stamp}</p>
          <blockquote class="postcard-quote">
            {home.postcard.quote.map((line, index) => (
              <>
                {line}
                {index < home.postcard.quote.length - 1 && <br />}
              </>
            ))}
          </blockquote>
          <div class="postcard-divider"></div>
          <p class="postcard-note">
            {home.postcard.note.map((line, index) => (
              <>
                {line}
                {index < home.postcard.note.length - 1 && <br />}
              </>
            ))}
          </p>
          <span class="postcard-tulip" aria-hidden="true">
            <TulipMark class="h-20 w-20" />
          </span>
        </div>
        <p class="hero-vertical">{home.vertical}</p>
      </aside>
    </div>

    <div class="container-page hero-foot">
      <p class="hero-scroll">
        <span aria-hidden="true"></span>
        {home.scrollLabel}
      </p>
      <p class="hero-meta">EST. {year} · 写给黄昏的慢信</p>
    </div>
  </section>

  <section class="home-section container-page">
    <div class="section-head">
      <div>
        <p class="eyebrow">RECENT LETTERS</p>
        <h2 class="section-title">最近写下的字</h2>
      </div>
      <a class="section-link" href="/blog/">
        全部文章
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {latestPosts.length > 0 ? (
      <div class="post-grid">
        {latestPosts.map((post, index) => <PostCard post={post} index={index} />)}
      </div>
    ) : (
      <p class="empty-state">纸还没有铺好，晚一点再来。</p>
    )}
  </section>

  <section class="home-section">
    <div class="container-page">
      <div class="quote-panel">
        <span class="quote-mark" aria-hidden="true">“</span>
        <p>
          {home.quote.map((line, index) => (
            <>
              {line}
              {index < home.quote.length - 1 && <br class="hidden sm:block" />}
            </>
          ))}
        </p>
        <span class="quote-source">{home.quoteSource}</span>
      </div>
    </div>
  </section>

  <section class="home-section container-page">
    <div class="section-head">
      <div>
        <p class="eyebrow">FRAGMENTS OF DUSK</p>
        <h2 class="section-title">黄昏切片</h2>
      </div>
      <a class="section-link" href="/life/">
        去看拾光集
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="photo-strip">
      {gallery.map((photo) => (
        <a class="photo-card" href="/life/">
          <img
            src={photo.src}
            alt={photo.alt}
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
          />
          <span class="photo-shade" aria-hidden="true"></span>
          <span class="photo-caption">
            <span class="photo-caption-title">{photo.title}</span>
            <span>{photo.note}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
