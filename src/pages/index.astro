---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TulipMark from '../components/TulipMark.astro';
import { site } from '../config';
import { formatDate, getPublishedPosts, getYear } from '../lib/posts';
import { moments, now, photos } from '../lib/data';

const posts = getPublishedPosts(await getCollection('blog'));
const latestPosts = posts.slice(0, 3);
const year = getYear();

const gallery = photos.slice(0, 3);
const { home } = site;
const hasNow = Boolean(
  now.focus || now.location || now.mood || now.reading || now.listening || now.note
);
---

<BaseLayout intro>
  <section class="home-hero">
    <div class="container-page hero-grid">
      <div class="hero-content" data-parallax="0.03">
        <p class="eyebrow hero-eyebrow">{home.eyebrow}</p>

        <div class="hero-title-wrap">
          <p class="hero-pretitle">{home.pretitle}</p>
          <h1 class="hero-title">
            {home.title}<span class="hero-title-accent">{home.titleAccent}</span>
          </h1>
          <p class="hero-title-en">{home.titleEn}</p>
        </div>

        <p class="hero-lead">
          {home.lead.map((line, index) => (
            <>
              {line}
              {index < home.lead.length - 1 && <br />}
            </>
          ))}
        </p>

        <div class="hero-intro glass">
          <span class="hero-seal" aria-hidden="true">
            <TulipMark class="h-7 w-7" />
          </span>
          <div>
            <p class="hero-intro-kicker">{home.introKicker}{site.author}</p>
            <p class="hero-intro-text">{site.intro}</p>
            <p class="hero-intro-meta">
              <span>{site.location}</span>
              <span class="meta-dot"></span>
              <span>{site.role}</span>
            </p>
          </div>
        </div>

        <div class="hero-actions">
          <a class="primary-btn" href="/blog/">
            去读几封信
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a class="text-link" href="/about/">关于这个角落 <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <aside class="hero-aside" aria-label="黄昏手记" data-parallax="0.07">
        <div class="hero-postcard">
          <p class="postcard-stamp">{home.postcard.stamp}</p>
          <blockquote class="postcard-quote">
            {home.postcard.quote.map((line, index) => (
              <>
                {line}
                {index < home.postcard.quote.length - 1 && <br />}
              </>
            ))}
          </blockquote>
          <div class="postcard-divider"></div>
          <p class="postcard-note">
            {home.postcard.note.map((line, index) => (
              <>
                {line}
                {index < home.postcard.note.length - 1 && <br />}
              </>
            ))}
          </p>
          <span class="postcard-tulip" aria-hidden="true">
            <TulipMark class="h-20 w-20" />
          </span>
        </div>
        <p class="hero-vertical">{home.vertical}</p>
      </aside>
    </div>

    <div class="container-page hero-foot">
      <p class="hero-scroll">
        <span aria-hidden="true"></span>
        {home.scrollLabel}
      </p>
      <p class="hero-meta">EST. {year} · 写给黄昏的慢信</p>
    </div>
  </section>

  {hasNow && (
    <section class="home-section container-page">
      <div class="section-head">
        <div>
          <p class="eyebrow">RIGHT NOW</p>
          <h2 class="section-title">此刻</h2>
        </div>
        <a class="section-link" href="/now/">
          看看我的此刻
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="now-grid">
        <article class="now-card now-card-wide">
          <p class="now-label">最近在做</p>
          <p class="now-value">{now.focus}</p>
        </article>
        <article class="now-card">
          <p class="now-label">坐标</p>
          <p class="now-value">{now.location}</p>
        </article>
        <article class="now-card">
          <p class="now-label">心情</p>
          <p class="now-value">{now.mood}</p>
        </article>
        <article class="now-card">
          <p class="now-label">在读</p>
          <p class="now-value">{now.reading}</p>
        </article>
        <article class="now-card">
          <p class="now-label">在听</p>
          <p class="now-value">{now.listening}</p>
        </article>
      </div>
    </section>
  )}

  <section class="home-section container-page">
    <div class="section-head">
      <div>
        <p class="eyebrow">RECENT LETTERS</p>
        <h2 class="section-title">最近写下的字</h2>
      </div>
      <a class="section-link" href="/blog/">
        全部文章
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {latestPosts.length > 0 ? (
      <div class="post-grid">
        {latestPosts.map((post, index) => <PostCard post={post} index={index} />)}
      </div>
    ) : (
      <p class="empty-state">纸还没有铺好，晚一点再来。</p>
    )}
  </section>

  {moments.length > 0 && (
    <section class="home-section container-page">
      <div class="section-head">
        <div>
          <p class="eyebrow">MOMENTS</p>
          <h2 class="section-title">近日动态</h2>
        </div>
        <a class="section-link" href="/moments/">
          全部动态
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="home-moments">
        {moments.slice(0, 3).map((moment) => (
          <a class="home-moment" href={`/moments/#${moment.id}`}>
            <time datetime={moment.date}>{formatDate(new Date(moment.date))}</time>
            <p>{moment.text}</p>
            <span>{[moment.mood, moment.location].filter(Boolean).join(' · ')}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="home-section">
    <div class="container-page">
      <div class="quote-panel">
        <span class="quote-mark" aria-hidden="true">“</span>
        <p>
          {home.quote.map((line, index) => (
            <>
              {line}
              {index < home.quote.length - 1 && <br class="hidden sm:block" />}
            </>
          ))}
        </p>
        <span class="quote-source">{home.quoteSource}</span>
      </div>
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="home-section container-page">
      <div class="section-head">
        <div>
          <p class="eyebrow">FRAGMENTS OF DUSK</p>
          <h2 class="section-title">黄昏切片</h2>
        </div>
        <a class="section-link" href="/gallery/">
          去看全部照片
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="photo-strip">
        {gallery.map((photo) => (
          <a class="photo-card" href="/gallery/">
            <img
              src={photo.src}
              alt={photo.alt}
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
            <span class="photo-shade" aria-hidden="true"></span>
            <span class="photo-caption">
              <span class="photo-caption-title">{photo.title}</span>
              <span>{photo.note}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="home-section container-page">
    <div class="section-head">
      <div>
        <p class="eyebrow">KEEP WANDERING</p>
        <h2 class="section-title">继续逛逛</h2>
      </div>
    </div>

    <div class="explore-grid">
      <a class="explore-card" href="/archive/">
        <span class="explore-index">01</span>
        <strong>归档</strong>
        <span>按年份和月份翻看所有文字</span>
      </a>
      <a class="explore-card" href="/tags/">
        <span class="explore-index">02</span>
        <strong>标签</strong>
        <span>顺着气味相近的词走一走</span>
      </a>
      <a class="explore-card" href="/friends/">
        <span class="explore-index">03</span>
        <strong>友链</strong>
        <span>去别人的黄昏里坐坐</span>
      </a>
      <a class="explore-card" href="/guestbook/">
        <span class="explore-index">04</span>
        <strong>留言板</strong>
        <span>路过的话，留一句再走</span>
      </a>
    </div>
  </section>
</BaseLayout>
