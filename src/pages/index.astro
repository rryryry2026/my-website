---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../config';
import { getPublishedPosts } from '../lib/posts';
import { photos, moments, now, footprints, wishes } from '../lib/data';
const posts = getPublishedPosts(await getCollection('blog')).slice(0, 3);
const shelves = [
  { no: '01', title: '相册', en: 'GALLERY', href: '/gallery/', desc: '把喜欢的光景留在这里', count: `${photos.length} 张照片`, icon: '◫' },
  { no: '02', title: '足迹', en: 'PLACES', href: '/footprints/', desc: '走过的地方，留下的故事', count: `${footprints.length} 个地点`, icon: '⌁' },
  { no: '03', title: '愿望清单', en: 'WISH LIST', href: '/wishes/', desc: '把期待的事情一件件写下', count: `${wishes.length} 个愿望`, icon: '✳' },
  { no: '04', title: '日常动态', en: 'MOMENTS', href: '/moments/', desc: '那些值得记住的小片段', count: `${moments.length} 条动态`, icon: '✎' },
];
const nowText = now.focus || now.note || now.reading || now.listening || now.mood || now.location;
---
<BaseLayout intro>
  <section class="house-hero container-page">
    <div class="house-hero-copy">
      <p class="house-overline"><span></span> A LITTLE PLACE FOR LIFE <span> / </span> 生活档案馆</p>
      <h1>把生活，<br /><em>好好收藏。</em></h1>
      <p class="house-lead">{site.description}</p>
      <div class="house-actions"><a class="house-button" href="/life/">打开生活档案 <span>↗</span></a><a class="house-text-link" href="/about/">认识我 <span>→</span></a></div>
      <div class="house-author"><span class="house-avatar">✳</span><div><strong>{site.author}</strong><small>{site.role}</small></div><span class="house-author-line"></span><span class="house-author-caption">记录生活中的<br />每一个寻常时刻</span></div>
    </div>
    <div class="house-hero-art" aria-label="生活档案馆封面">
      <div class="house-art-top"><span>THE LIFE ARCHIVE</span><span>VOL. 01 / WAN XIANG</span></div>
      <div class="house-art-image"><img src="/assets/gallery/frame-1.jpg" alt="黄昏时的风景" /><span class="house-art-badge">LIFE<br />IS<br />HERE ✳</span></div>
      <div class="house-art-bottom"><div><small>COLLECT THE ORDINARY</small><strong>日子值得被记录</strong></div><span>01 — 04</span></div>
    </div>
  </section>
  <section class="container-page house-section">
    <div class="house-heading"><div><p class="house-kicker">EXPLORE THE ARCHIVE / 01</p><h2>生活的收藏夹<span>✳</span></h2></div><p>照片、故事和那些还没实现的期待，<br />都在这里慢慢积攒。</p></div>
    <div class="house-shelves">{shelves.map((item) => <a href={item.href} class="house-shelf"><div class="house-shelf-top"><span>{item.no} / {item.en}</span><span>↗</span></div><span class="house-shelf-icon" aria-hidden="true">{item.icon}</span><div><h3>{item.title}</h3><p>{item.desc}</p></div><span class="house-shelf-count">{item.count}</span></a>)}</div>
  </section>
  <section class="container-page house-section house-journal">
    <div class="house-heading"><div><p class="house-kicker">RECENT WRITING / 02</p><h2>最近写下的字<span>✳</span></h2></div><a class="house-text-link" href="/blog/">查看全部文章 →</a></div>
    {posts.length ? <div class="post-grid">{posts.map((post, index) => <PostCard post={post} index={index} />)}</div> : <p class="empty-state">还没有文章，故事会慢慢写下来。</p>}
  </section>
  <section class="container-page house-now house-section"><div><p class="house-kicker">A NOTE FROM NOW / 03</p><h2>此时此刻，<br /><em>生活正在发生。</em></h2><p>{nowText || '这一页留给正在发生的生活，等有想记录的时候再写下来。'}</p><a class="house-text-link" href="/now/">看看我的近况 →</a></div><div class="house-now-mark" aria-hidden="true">✳<small>AN ORDINARY<br />DAY, WELL KEPT.</small></div></section>
</BaseLayout>
