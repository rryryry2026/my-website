---
import BaseLayout from '../layouts/BaseLayout.astro';
import TulipMark from '../components/TulipMark.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site } from '../config';

const { about } = site;
---

<BaseLayout
  title="关于我"
  description="关于晚巷、关于我，以及这个想用来收藏黄昏的小小角落。"
>
  <section class="page-intro container-page">
    <p class="eyebrow">ABOUT · 关于</p>
    <div class="page-intro-grid">
      <h1 class="page-title">{about.title}<br /><em>{about.titleAccent}</em></h1>
      <div class="page-intro-side">
        <p class="page-desc">{about.description}</p>
      </div>
    </div>
  </section>

  <section class="container-page about-section">
    <div class="about-grid">
      <div class="about-photo-wrap">
        <figure class="about-photo">
          <img
            src={about.photo.src}
            alt={about.photo.alt}
            width="1280"
            height="720"
            loading="eager"
            decoding="async"
          />
          <figcaption>{about.photo.caption}</figcaption>
        </figure>
        <span class="about-photo-tape" aria-hidden="true"></span>
      </div>

      <div class="about-content glass">
        <span class="about-seal" aria-hidden="true">
          <TulipMark class="h-7 w-7" />
        </span>
        <p class="eyebrow">NICE TO MEET YOU</p>
        <h2 class="about-title">我是{site.author}</h2>
        <p class="about-lead">{site.intro}</p>
        {about.texts.map((text) => <p class="about-text">{text}</p>)}

        <dl class="about-facts">
          {about.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>

        <div class="about-contact">
          <a class="primary-btn" href={`mailto:${site.email}`}>
            写信给我
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <div class="about-socials" aria-label="社交链接">
            {site.socials.map((social) => (
              <a
                class="social-link"
                href={social.href}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={social.href.startsWith('http') ? 'noreferrer noopener' : undefined}
                aria-label={social.label}
                title={social.label}
              >
                <SocialIcon icon={social.icon} />
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page about-section">
    <div class="about-site-note">
      <p class="eyebrow">ABOUT THIS CORNER</p>
      <p class="about-site-quote">{about.siteQuote}</p>
      <p class="about-site-text">{about.siteText}</p>
    </div>
  </section>
</BaseLayout>
