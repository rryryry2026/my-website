---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { photos, moments, footprints, wishes } from '../../lib/data';
const entries = [
  { no: '01', title: '相册', en: 'GALLERY', desc: '留住那些想要再看一眼的光景。', href: '/gallery/', count: `${photos.length} 张照片`, icon: '◫' },
  { no: '02', title: '足迹', en: 'PLACES', desc: '走过的地方，和沿途的故事。', href: '/footprints/', count: `${footprints.length} 个地点`, icon: '⌁' },
  { no: '03', title: '愿望清单', en: 'WISH LIST', desc: '给未来的自己留一些期待。', href: '/wishes/', count: `${wishes.length} 个愿望`, icon: '✳' },
  { no: '04', title: '日常动态', en: 'MOMENTS', desc: '不必成篇，也值得被记住。', href: '/moments/', count: `${moments.length} 条动态`, icon: '✎' },
  { no: '05', title: '此时此刻', en: 'RIGHT NOW', desc: '最近正在经历的生活。', href: '/now/', count: '我的近况', icon: '◷' },
  { no: '06', title: '生活随笔', en: 'JOURNAL', desc: '把日子写成可以翻阅的文字。', href: '/blog/', count: '阅读文章', icon: '≋' },
];
---
<BaseLayout title="生活档案" description="收藏照片、足迹、愿望和日常的生活档案馆。">
  <section class="container-page archive-intro"><p class="house-kicker">THE LIFE ARCHIVE / 生活档案馆</p><h1>把寻常日子，<br /><em>收进时光里。</em></h1><div class="archive-intro-bottom"><p>这里收藏生活的不同切面。慢慢翻，总会找到一个值得停留的瞬间。</p><span>COLLECTING LITTLE MOMENTS<br />ONE DAY AT A TIME ↘</span></div></section>
  <section class="container-page house-section archive-collection"><div class="house-heading"><div><p class="house-kicker">ALL COLLECTIONS</p><h2>打开一格收藏<span>✳</span></h2></div><span>01 — 06</span></div><div class="house-shelves">{entries.map((item) => <a href={item.href} class="house-shelf"><div class="house-shelf-top"><span>{item.no} / {item.en}</span><span>↗</span></div><span class="house-shelf-icon" aria-hidden="true">{item.icon}</span><div><h3>{item.title}</h3><p>{item.desc}</p></div><span class="house-shelf-count">{item.count}</span></a>)}</div></section>
</BaseLayout>
